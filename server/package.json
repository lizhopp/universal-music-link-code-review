{
  "name": "server",
  "version": "1.0.0",
  "description": "backend for universal music link",
  "homepage": "https://github.com/Darthlyrical/universal-music-link#readme",
  "bugs": {
    "url": "https://github.com/Darthlyrical/universal-music-link/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Darthlyrical/universal-music-link.git"
  },
  "license": "ISC",
  "author": "Jorge Miranda",
  "type": "module",
  "imports": {
    "#*": "./*.js"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "nodemon --env-file=.env server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:create": "createdb universal_music_link",
    "db:drop": "dropdb --if-exists universal_music_link",
    "db:schema": "psql -d universal_music_link -f db/schema.sql",
    "db:seed": "node --env-file=.env db/seed.js",
    "db:init": "npm run db:create && npm run db:schema && npm run db:seed",
    "db:reset": "npm run db:drop && npm run db:init",
    "db:tables": "psql -d universal_music_link -c '\\dt'"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "nodemon": "^3.1.14",
    "pg": "^8.20.0"
  }
}
